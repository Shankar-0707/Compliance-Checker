# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# Real Backend API URL (FastAPI teammate backend)
# Example: http://localhost:8000/api/analyze
# When left unset or empty, the frontend runs in dev demo mode using the local mock endpoint.
NEXT_PUBLIC_API_URL=

# =============================================================================
# CLOUDINARY CONFIGURATION (Product Label Image Storage)
# =============================================================================
# Get these keys from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# (Optional alternative: CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name)
