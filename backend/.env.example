# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (async asyncpg driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/compliance_db

# ─── ML Service ─────────────────────────────────────────────────────────────
# Base URL of the teammate's FastAPI ML service
ML_SERVICE_URL=http://localhost:8001

# ─── Cloudinary ─────────────────────────────────────────────────────────────
# Get these from your Cloudinary dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
